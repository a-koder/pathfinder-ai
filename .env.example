OPENAI_API_KEY=your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=pathfinder-ai
DEFAULT_MODEL=gpt-4o-mini
EVAL_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Optional - LangSmith tracing. The app works fully without these.
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=pathfinder-ai
LANGSMITH_TRACING=false

# Prompt / ruleset versions. Each defaults to "v1" (or "rascef_v1" for evaluation) if unset.
DISCOVERY_PROMPT_VERSION=v1
RECOMMENDATION_PROMPT_VERSION=v1
PATH_PLANNING_PROMPT_VERSION=v1
EVALUATION_PROMPT_VERSION=rascef_v1
GUARDRAIL_RULESET_VERSION=v1
INPUT_GUARDRAIL_RULESET_VERSION=v1

# Optional - overall agent/system version tag, surfaced in LangSmith metadata.
AGENT_VERSION=v1
